{
  "name": "pinease-complete",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:rust": "node scripts/cargo-cli.mjs test",
    "dev": "vite --port 5180",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "build:icon": "node scripts/build-icon.mjs",
    "prebuild": "npm run build:icon",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "tauri": "node scripts/tauri-cli.mjs",
    "desktop:dev": "node scripts/tauri-cli.mjs dev",
    "desktop:run": "node scripts/tauri-cli.mjs dev",
    "build:desktop": "npm run type-check && node scripts/tauri-cli.mjs build",
    "type-check": "vue-tsc --build",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "echarts": "^6.1.0",
    "idb": "^8.0.4",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^4.0.3",
    "reka-ui": "^2.11.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.6",
    "sharp": "^0.35.5",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
