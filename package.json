{
  "name": "pinease-complete",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "vite --port 5180",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "build:icon": "node scripts/build-icon.mjs",
    "prebuild": "npm run build:icon",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "build:desktop": "npm run build && electron-builder --win nsis --x64",
    "desktop:run": "npm run build-only && electron .",
    "type-check": "vue-tsc --build",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "echarts": "^6.1.0",
    "idb": "^8.0.4",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^4.0.3",
    "reka-ui": "^2.11.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.6",
    "sharp": "^0.35.5",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "build": {
    "appId": "cn.pinease.desktop",
    "productName": "PinEase",
    "asar": true,
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "public/favicon.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
